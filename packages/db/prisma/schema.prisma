// CheqPay custodial wallet — Prisma schema (Phase 0).
//
// MONEY RULE: every monetary amount is stored as an INTEGER in minor units
// using BigInt — kobo for NGN, satoshis for BTC, 6-decimal base units for
// USDT. No floating point anywhere in financial state. Rates (ratios, not
// money) use Decimal for precision.
//
// Asset/Network are enums for compile-time safety in financial logic
// (the brief forbids `any` in money paths). Adding a new network later is a
// single additive enum value + migration.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection (PgBouncer) for the app runtime.
  url       = env("DATABASE_URL")
  // Direct connection for migrations / introspection.
  directUrl = env("DIRECT_URL")
}

// ----------------------------------------------------------------------------
// Enums
// ----------------------------------------------------------------------------

enum Asset {
  NGN
  BTC
  USDT
  USDC
  USD // fiat USD — held via a Maplerad USD virtual account
}

enum Network {
  FIAT // NGN
  BITCOIN // BTC
  TRON // USDT TRC-20
  BSC // USDT BEP-20
  ETHEREUM // USDT/USDC ERC-20
  SOLANA // USDT/USDC SPL — the only chain Maplerad documents for withdrawal
  BASE // USDT/USDC on Base
  POLYGON // USDT/USDC on Polygon
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BLOCKED
  /// Account closed at the user's request. The row is kept, with its personal
  /// data scrubbed, because deleting it would cascade away the transaction and
  /// KYC history that AML law requires to be retained. See lib/retention.ts.
  DELETED
}

enum TransactionType {
  DEPOSIT // crypto or NGN inbound
  WITHDRAWAL // crypto or NGN outbound
  BUY // NGN -> crypto
  SELL // crypto -> NGN
  CONVERT // crypto -> crypto
  BILL // NGN -> bill payment (airtime, data, electricity, cable TV, betting)
  CASHBACK // NGN reward credited on a qualifying transaction
  TRANSFER_OUT // sent to another CheqPay user (internal)
  TRANSFER_IN // received from another CheqPay user (internal)
}

enum TransactionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REVERSED
}

enum KycStatus {
  PENDING
  APPROVED
  REJECTED
}

// ----------------------------------------------------------------------------
// Core models (brief §7)
// ----------------------------------------------------------------------------

model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique
  // Credentials are managed by Supabase Auth; these are optional here.
  phone        String?    @unique
  passwordHash String?    @map("password_hash")
  kycTier      Int        @default(0) @map("kyc_tier")
  status       UserStatus @default(ACTIVE)
  // Editable profile fields. Username is unique (nulls allowed); DOB is set on
  // KYC submission and locked once verified; next of kin is free-form.
  username     String?    @unique
  dateOfBirth  DateTime?  @map("date_of_birth") @db.Date
  nextOfKin    String?    @map("next_of_kin")
  /// Legal name as verified at KYC — NOT the display name. Required to answer
  /// "which account belongs to this person?"; Supabase Auth metadata is not a
  /// record of account, and does not survive an auth-user deletion.
  legalName    String?    @map("legal_name")
  /// BVN, stored three ways for three jobs. See lib/pii.ts.
  /// Ciphertext is producible to a regulator; the fingerprint makes lookup an
  /// indexed query; the last 4 let staff confirm a match without seeing it all.
  bvnCiphertext String?   @map("bvn_ciphertext")
  bvnFingerprint String?  @map("bvn_fingerprint")
  bvnLast4     String?    @map("bvn_last4")
  /// Government ID captured at KYC (NIN / passport / voter's card / driver's
  /// licence). The number is regulated PII, so it is stored encrypted the same
  /// way the BVN is (ciphertext + last 4); the images live in private object
  /// storage, referenced from KycRecord.documentRefs. Columns are created at
  /// boot by ensureKycDocSchema() — see lib/mapleradCustomer.ts.
  idDocType             String? @map("id_doc_type")
  idDocNumberCiphertext String? @map("id_doc_number_ciphertext")
  idDocNumberLast4      String? @map("id_doc_number_last4")
  // When true, crypto withdrawals skip the per-request 2FA (AAL2) step.
  instantWithdrawal Boolean @default(false) @map("instant_withdrawal")
  // Per-category push/notification opt-ins (see lib/notifications defaults).
  notificationPrefs Json? @map("notification_prefs")
  // Registered Expo push tokens for this user's devices.
  pushTokens   String[]   @default([]) @map("push_tokens")
  // Maplerad customer id — the foreign key every Maplerad resource (stablecoin
  // deposit addresses, cards) hangs off. Enrolled best-effort at KYC approval,
  // the one moment the BVN is in hand; null until then.
  mapleradCustomerId String? @unique @map("maplerad_customer_id")
  /// Highest Maplerad tier we have successfully upgraded this customer to.
  /// Collections — and therefore NGN deposit accounts — need tier 1.
  mapleradTier       Int     @default(0) @map("maplerad_tier")

  /// Street address, kept so the tier 1 upgrade can be retried later. It used
  /// to live only in the KYC request body, so a user whose upgrade failed could
  /// never be upgraded again without filling the whole form in a second time.
  addressStreet      String? @map("address_street")
  addressCity        String? @map("address_city")
  addressState       String? @map("address_state")
  addressPostalCode  String? @map("address_postal_code")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  /// Where and when this account was last active. Denormalized from
  /// UserSession so the admin list can show it without a join per row.
  lastSeenAt     DateTime? @map("last_seen_at")
  lastIp         String?   @map("last_ip")
  lastDevice     String?   @map("last_device")
  /// The last route this account called, e.g. "/api/transfers". Path only —
  /// query strings can carry secrets.
  lastAction     String?   @map("last_action")

  wallets       Wallet[]
  balances      Balance[]
  quotes        Quote[]
  transactions  Transaction[]
  kycRecords    KycRecord[]
  auditLogs     AuditLog[]
  beneficiaries Beneficiary[]
  cards         Card[]
  sessions      UserSession[]

  @@index([bvnFingerprint])
  @@index([legalName])
  @@map("app_users")
}

/// One row per (account, IP, device) the account has been seen from.
///
/// Not a session in the auth sense — Supabase owns those. This is the security
/// history: "this account has been used from an iPhone in Lagos since June, and
/// from Windows in Kyiv since Tuesday" is the shape of the question it answers,
/// and the answer is what makes account takeover visible.
///
/// Keyed on (userId, ipAddress, userAgent) so a returning device updates its
/// row rather than adding one. The columns are NOT NULL with '' defaults on
/// purpose: in Postgres NULLs never collide, so a nullable unique key would let
/// unknown-IP rows accumulate without limit.
model UserSession {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  ipAddress   String   @default("") @map("ip_address")
  userAgent   String   @default("") @map("user_agent")
  /// Readable label, e.g. "iPhone · Safari".
  device      String?
  /// "web" | "mobile" | "unknown"
  platform    String   @default("unknown")
  /// How many times this device/IP pair has been seen.
  hitCount    Int      @default(1) @map("hit_count")
  firstSeenAt DateTime @default(now()) @map("first_seen_at")
  lastSeenAt  DateTime @default(now()) @map("last_seen_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, ipAddress, userAgent])
  @@index([userId])
  @@index([lastSeenAt])
  @@map("user_sessions")
}

/// Identity snapshot taken when an account is closed, retained for AML
/// record-keeping.
///
/// Deliberately has NO foreign key to User. The point of this table is to
/// survive independently: if a User row is ever hard-deleted (by a future
/// migration, an operator, or a mistake) the record of who held the account
/// must not go with it. Nigeria's MLPPA 2022 and the CBN AML/CFT regulations
/// require customer identification records for at least five years after the
/// business relationship ends.
///
/// This is also the answer to the NDPA tension: an erasure request does not
/// override statutory retention. The live profile is scrubbed; the regulated
/// minimum is kept here, restricted to compliance use, with an explicit expiry.
model RetainedSubject {
  id             String    @id @default(uuid()) @db.Uuid
  /// The former User.id. Transactions and audit logs still reference it, so
  /// this is the join back to the retained history.
  userId         String    @unique @map("user_id") @db.Uuid
  legalName      String?   @map("legal_name")
  email          String
  phone          String?
  username       String?
  dateOfBirth    DateTime? @map("date_of_birth") @db.Date
  bvnCiphertext  String?   @map("bvn_ciphertext")
  bvnFingerprint String?   @map("bvn_fingerprint")
  bvnLast4       String?   @map("bvn_last4")
  kycTier        Int       @map("kyc_tier")
  /// Why this record exists, e.g. "account_deleted".
  reason         String
  /// When retention lapses and this row may lawfully be destroyed. Nothing
  /// deletes automatically — expiry is a decision, not a cron job.
  retainUntil    DateTime  @map("retain_until")
  closedAt       DateTime  @default(now()) @map("closed_at")

  @@index([bvnFingerprint])
  @@index([email])
  @@index([phone])
  @@index([legalName])
  @@map("retained_subjects")
}

// A saved NGN payout destination (bank account) for withdrawals. The account
// name is resolved via the PSP and verified to match the user's legal name at
// save time, so payouts can only go to the user's own accounts.
model Beneficiary {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  bankCode      String   @map("bank_code")
  bankName      String   @map("bank_name")
  accountNumber String   @map("account_number")
  accountName   String   @map("account_name")
  createdAt     DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, bankCode, accountNumber])
  @@index([userId])
  @@map("beneficiaries")
}

// A provider-issued virtual card (Maplerad). We store only the provider's card
// reference and safe display metadata — never full PAN, CVV or expiry. The
// sensitive card details are fetched on demand from the provider when the user
// reveals them.
// A Maplerad virtual card. Issuing is ASYNC: create returns a `reference`, and
// the real card id + final status arrive by the issuing webhook. So a card is
// born `pending` with only its reference, then reconciled to `active`/`failed`.
model Card {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  provider       String   @default("maplerad")
  /// Creation reference from POST /issuing — how the webhook reconciles.
  reference      String?  @unique
  /// Provider card id, filled in once the issuing webhook confirms.
  providerCardId String?  @map("provider_card_id")
  currency       String   @default("USD")
  brand          String?
  maskedPan      String?  @map("masked_pan")
  status         String   @default("pending")
  createdAt      DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("cards")
}

// One immutable on-chain deposit address per asset/network, backed by a
// custody-provider virtual account. We store only the provider reference —
// never a private key.
model Wallet {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  asset      Asset
  network    Network
  address    String
  custodyRef String   @map("custody_ref") // provider virtual-account id
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, asset, network])
  // Deposit webhooks match an incoming (network, address) back to a wallet.
  @@unique([network, address])
  // Named distinctly to avoid colliding with the legacy `wallets` table and the
  // existing HollaEx `crypto_wallets` table.
  @@map("custody_wallets")
}

// Internal ledger balance per user per asset, in minor units.
model Balance {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  asset     Asset
  available BigInt   @default(0) // spendable, minor units
  locked    BigInt   @default(0) // reserved by open quotes / pending withdrawals
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, asset])
  @@map("balances")
}

// Server-issued swap quote with a short TTL. The client never sets the rate.
model Quote {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  fromAsset Asset    @map("from_asset")
  toAsset   Asset    @map("to_asset")
  rate      Decimal  @db.Decimal(38, 18) // toAsset per 1 fromAsset (incl. spread)
  amountIn  BigInt   @map("amount_in") // minor units of fromAsset
  amountOut BigInt   @map("amount_out") // minor units of toAsset
  consumed  Boolean  @default(false)
  // For a quote backed by an external provider (Maplerad FX on NGN↔USD), the
  // provider's own quote reference to settle at execute time. Null otherwise.
  providerRef String? @map("provider_ref")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([userId])
  @@index([expiresAt])
  @@map("quotes")
}

model Transaction {
  id             String            @id @default(uuid()) @db.Uuid
  userId         String            @map("user_id") @db.Uuid
  type           TransactionType
  asset          Asset
  network        Network?
  amount         BigInt // minor units
  fee            BigInt            @default(0) // minor units
  status         TransactionStatus @default(PENDING)
  txHash         String?           @map("tx_hash") // on-chain hash (crypto)
  externalRef    String?           @map("external_ref") // provider/PSP reference
  idempotencyKey String            @unique @map("idempotency_key")
  quoteId        String?           @map("quote_id") @db.Uuid
  metadata       Json              @default("{}")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  quote Quote? @relation(fields: [quoteId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@index([type])
  @@index([createdAt])
  @@map("ledger_transactions")
}

model KycRecord {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  tier         Int
  documentRefs String[]  @map("document_refs")
  status       KycStatus @default(PENDING)
  reviewedAt   DateTime? @map("reviewed_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("kyc_records")
}

// Idempotency + audit store for inbound provider/PSP webhooks. Signature is
// verified before any state change; the unique eventId prevents replay.
model WebhookEvent {
  id             String    @id @default(uuid()) @db.Uuid
  source         String // "maplerad"
  eventId        String    @map("event_id") // provider-supplied unique id
  payload        Json
  signatureValid Boolean   @map("signature_valid")
  processedAt    DateTime? @map("processed_at")
  receivedAt     DateTime  @default(now()) @map("received_at")

  @@unique([source, eventId])
  @@index([processedAt])
  @@map("webhook_events")
}

// Business-controlled platform settings, editable from the admin dashboard.
// The swap spread/margin and the USDT->NGN rate live here so the business can
// change them without a deploy. Values are stored as strings and parsed/typed
// on read (see apps/api settings service). This is the server-side source of
// truth; env vars only seed initial defaults.
model PlatformSetting {
  key       String   @id // e.g. "swap_spread_bps", "usdt_ngn_rate"
  value     String
  updatedBy String?  @map("updated_by") // admin id/email for the audit trail
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("platform_settings")
}

// Append-only audit trail for every financial action (brief §8).
model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String?  @map("user_id") @db.Uuid
  action       String
  resourceType String?  @map("resource_type")
  resourceId   String?  @map("resource_id")
  details      Json     @default("{}")
  ipAddress    String?  @map("ip_address")
  createdAt    DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs_v2")
}

// Admin-uploaded brand logos for bill billers (keyed by catalog biller id).
// `logo` is a data URL (uploaded from the admin dashboard) or an external URL.
model BillerAsset {
  billerId  String   @id @map("biller_id")
  logo      String
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("biller_assets")
}
