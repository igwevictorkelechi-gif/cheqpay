# CheqPay Creators (creator.mycheqpay.com) — Apache/LiteSpeed configuration.
# Copied into the export automatically; upload the contents of out/ to the
# subdomain's document root. Plain files only: the pages talk to the CheqPay
# API over HTTPS from the browser.

Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # HTTPS only: the sign-in session lives in the browser.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  # Tracking links: every /r/CODE is the one static page, which reads the code
  # from the address bar, counts the click and forwards to sign-up.
  RewriteRule ^r/[A-Za-z0-9-]+/?$ /r/index.html [L]

  # Pages are folders (trailingSlash): /dashboard -> /dashboard/
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.*[^/])$ /$1/ [R=301,L]

  # A failed RSC prefetch navigates to the payload itself; send the browser to its page.
  RewriteCond %{HTTP_ACCEPT} text/html
  RewriteCond %{HTTP:RSC} !=1
  RewriteRule ^(.*/)?index\.txt$ /$1 [R=302,L]
</IfModule>

ErrorDocument 404 /404.html

<IfModule mod_headers.c>
  Header always set X-Frame-Options "DENY"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

  # Pages change on every upload; hashed assets never do.
  <FilesMatch "\.(html|txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
<IfModule mod_headers.c>
  <If "%{REQUEST_URI} =~ m#^/_next/static/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
</IfModule>

AddType font/woff2 .woff2
AddType application/manifest+json .webmanifest
