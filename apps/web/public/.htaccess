# CheqPay web app — Apache/LiteSpeed configuration for cPanel hosting.
#
# Copied into the export automatically (everything in public/ is), so uploading
# the contents of `out/` to public_html brings this with it.
#
# There is no PHP here and none is needed: every page is pre-rendered HTML that
# talks to the CheqPay API over HTTPS from the browser. The host only serves
# files.

# ---- HTTPS ----------------------------------------------------------------
# A money app must never be reachable over plain HTTP: the Supabase session
# token lives in the browser and would be readable on the wire.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]
</IfModule>

# ---- Canonical host -------------------------------------------------------
# www and the apex are two different addresses as far as a search engine is
# concerned. Served from both, every inbound link splits its value between them
# and neither ranks as well as one would. The pages canonicalise to the apex
# (see lib/site.ts), so send www there too and keep the two consistent.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^(.*)$ https://%1/$1 [R=301,L]
</IfModule>

# ---- Failed RSC prefetches ------------------------------------------------
# The export emits an index.txt (the RSC payload) beside every index.html. Next
# prefetches those for every visible link, and when one fails it falls back to a
# hard browser navigation to the payload URL itself — so a transient network
# blip on this host leaves the user parked on /crypto/index.txt looking at raw
# text. Send those navigations to the page the payload belongs to.
#
# The conditions are load-bearing: Next's own fetch() for the payload must keep
# receiving the file, or client-side routing stops working entirely — which is
# worse than the bug being fixed. Two independent guards, either of which is
# sufficient, because getting this wrong breaks every navigation:
#
#   Accept  a real browser navigation asks for text/html. Measured against this
#           build, Next's prefetch sends `Accept: */*` — note that is NOT
#           text/x-component, so match on text/html being PRESENT rather than
#           on any assumed payload type.
#   RSC     Next sets `RSC: 1` on payload requests and browsers never do.
#
# The optional group also covers the root payload (/index.txt -> /), which a
# path anchored on a slash would miss. Query strings (?_rsc=…) are not part of
# a RewriteRule pattern, so they do not need handling here.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_ACCEPT} text/html
  RewriteCond %{HTTP:RSC} !=1
  RewriteRule ^(.*/)?index\.txt$ /$1 [R=302,L]
</IfModule>

# ---- Directory index ------------------------------------------------------
# The export is built with trailingSlash, so every route is a folder holding an
# index.html. This is what makes /login work with no rewrite rules at all.
DirectoryIndex index.html
Options -Indexes

# Next writes its own 404 page; use it rather than Apache's.
ErrorDocument 404 /404.html

# ---- Caching --------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On

  # Hashed filenames — the content can never change under a given name, so
  # these are safe to cache for a year and are what makes repeat visits fast.
  <FilesMatch "\.(js|css|woff2)$">
    ExpiresDefault "access plus 1 year"
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "\.(png|jpg|jpeg|gif|svg|ico|webp)$">
    ExpiresDefault "access plus 30 days"
  </FilesMatch>

  # HTML must NOT be cached hard: it is the file that points at the current
  # hashed bundles, so a stale copy pins the browser to a deployment you have
  # already replaced.
  <FilesMatch "\.(html|webmanifest)$">
    ExpiresDefault "access plus 0 seconds"
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  # The service worker likewise — a cached one keeps serving the old app.
  <Files "sw.js">
    ExpiresDefault "access plus 0 seconds"
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </Files>
</IfModule>

# ---- Compression ----------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml \
    application/javascript application/json application/manifest+json \
    image/svg+xml
</IfModule>

# ---- Security headers -----------------------------------------------------
<IfModule mod_headers.c>
  # Keep these identical to the "headers" block in /vercel.json — the site is
  # served from both hosts, and a test (apps/api/src/lib/webSecurityHeaders.test.ts)
  # fails if they drift apart.
  # Scripts, styles, data and frames only from where CheqPay actually loads them,
  # so an injected script can't run or send data anywhere else.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.supabase.co; font-src 'self' data:; connect-src 'self' https://xttgnswgeffyybjfjlkp.supabase.co wss://xttgnswgeffyybjfjlkp.supabase.co https://cheqpay-admin453.vercel.app https://api.mycheqpay.com https://*.ingest.sentry.io; worker-src 'self'; manifest-src 'self'; frame-src 'none'; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests"
  # HTTPS only, remembered by the browser for a year. includeSubDomains/preload
  # are left off until every subdomain (mail, cpanel, …) is confirmed on HTTPS.
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Cross-Origin-Resource-Policy "same-site"

  # Do not advertise the server version.
  Header unset X-Powered-By
</IfModule>

# ---- Correct types --------------------------------------------------------
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType image/svg+xml .svg
  AddType font/woff2 .woff2
</IfModule>
