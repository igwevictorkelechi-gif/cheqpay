{
  "expo": {
    "name": "CheqPay",
    "slug": "cheqpsy-",
    "owner": "boliempire",
    "version": "1.0.0",
    "scheme": "cheqpay",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/d687cf5e-de27-4ba0-8dfe-77506f45addf",
      "fallbackToCacheTimeout": 0
    },
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#14121A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cheqpay.app",
      "associatedDomains": ["applinks:mycheqpay.com"]
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.cheqpay.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [{ "scheme": "https", "host": "mycheqpay.com", "pathPrefix": "/pay" }],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow CheqPay to use the camera to scan pay codes."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow CheqPay to use Face ID to unlock the app."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "CheqPay needs access to your photos so you can upload your ID document for identity verification.",
          "cameraPermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "default",
          "sounds": []
        }
      ],
      [
        "expo-alternate-app-icons",
        [
          {
            "name": "Midnight",
            "ios": "./assets/icons/icon-midnight.png",
            "android": {
              "foregroundImage": "./assets/icons/icon-midnight.png",
              "backgroundColor": "#14121A"
            }
          },
          {
            "name": "Mint",
            "ios": "./assets/icons/icon-mint.png",
            "android": {
              "foregroundImage": "./assets/icons/icon-mint.png",
              "backgroundColor": "#34C759"
            }
          },
          {
            "name": "Gold",
            "ios": "./assets/icons/icon-gold.png",
            "android": {
              "foregroundImage": "./assets/icons/icon-gold.png",
              "backgroundColor": "#F5A623"
            }
          }
        ]
      ],
      "./plugins/withPentestVariant"
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "d687cf5e-de27-4ba0-8dfe-77506f45addf"
      }
    }
  }
}
