{
  "framework": "nextjs",
  "installCommand": "cd ../.. && bun install",
  "buildCommand": "cd ../.. && bunx prisma generate --schema packages/db/prisma/schema.prisma && cd apps/api && bunx next build",
  "outputDirectory": ".next",
  "crons": [
    {
      "path": "/api/cron/price-alerts",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/treasury-check",
      "schedule": "30 7 * * *"
    }
  ]
}
