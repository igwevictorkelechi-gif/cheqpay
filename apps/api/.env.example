# ---- Runtime ----
NODE_ENV="development"

# ---- Database (Supabase Postgres) — Phase 2 ----
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ---- Auth — Phase 1 ----
# Supabase Auth issues the JWTs; copy the project's JWT secret here so the API
# can verify them. (Supabase dashboard -> Settings -> API -> JWT Secret.)
SUPABASE_JWT_SECRET="your-supabase-jwt-secret"
# Admin auth — service secret (backend-to-backend, e.g. admin dashboard proxy)
ADMIN_API_SECRET="generate-a-strong-16+char-secret"
# Admin auth — allowlist of admin user emails (comma-separated). Admins are
# Supabase users with app_metadata.role="admin" OR an email listed here.
ADMIN_EMAILS=""

# ---- AML (Phase 6) — thresholds in whole NGN ----
AML_LARGE_AMOUNT_NGN="1000000"        # flag single withdrawals at/above this
AML_REVIEW_THRESHOLD_NGN="5000000"    # hold for manual review at/above this
AML_VELOCITY_COUNT="10"               # withdrawals/day before review
AML_VELOCITY_SUM_NGN="10000000"       # daily withdrawal sum before review
SANCTIONED_ADDRESSES=""               # comma-separated blocked addresses

# ---- Custody — Phase 2 ----
# "mock" (default, no external calls) or "maplerad" (stablecoin: USDT/USDC on
# ERC-20; reuses MAPLERAD_SECRET_KEY below). No provider offers BTC — it stays
# "coming soon". NOTE: crypto_deposits / crypto_withdrawals feature flags
# default OFF (compliance + a Maplerad-side sandbox bug); flip them in the
# admin dashboard only after VASP registration and a verified sandbox run.
CUSTODY_PROVIDER="mock"

# ---- Naira rail — Phase 3 ----
# "mock" (default, no external calls) or "maplerad" (requires the keys below).
# Maplerad runs bills (airtime/data/electricity/cable), payouts, name enquiry and
# the bank list.
#
# Before switching to "maplerad", read apps/api/GO-LIVE.md. The short version:
# the live key requires a whitelisted egress IP, so the API must already be on a
# host that has one (see VPS.md / RENDER.md) — flipping this on Vercel makes
# every Maplerad call fail the whitelist.
#
# (Bill plans no longer need reconciling by hand: lib/billCatalog.ts fetches data
# bundles and cable bouquets live from the provider and serves none rather than
# invented ones if it cannot reach them. The prices in lib/bills.ts are mock-only.)
PAYMENT_PROVIDER="mock"
MAPLERAD_SECRET_KEY=""        # sandbox or live secret key (live requires a whitelisted egress IP)
MAPLERAD_BASE_URL="https://api.maplerad.com/v1"
MAPLERAD_WEBHOOK_SECRET=""    # Svix signing secret (whsec_...) — verifies payout settlement webhooks

# ---- Rates / market data — Phase 4 ----
# "live" (Binance + CoinGecko fallback) or "mock" (deterministic, for tests).
PRICE_FEED="live"
BINANCE_API_BASE="https://api.binance.com"
BUSINESS_USDT_NGN_RATE=""   # business-controlled USDT->NGN rate
SWAP_SPREAD_BPS="150"       # 1.5% spread (basis points)

# ---- Transactional email (Resend) ----
# Used to deliver account statements (PDF/CSV) to the user's account email.
# With either value blank the statement feature stays dark: the request route
# returns 503 "email_not_configured" and the clients hide the entry point.
# MAIL_FROM must be a sender on a domain verified in the Resend dashboard,
# otherwise Resend rejects the send.
RESEND_API_KEY=""                              # re_... from https://resend.com/api-keys
MAIL_FROM=""                                   # e.g. "CheqPay <statements@cheqpay.com>"

# ---- Compliance / record retention ----
# Encrypts the BVN at rest. Nigerian AML law requires customer identification
# records to be retained and producible to the authorities, so the BVN is stored
# recoverably rather than only hashed — which makes the key the thing protecting
# it. Keep it OUT of the database's backup scope, and back it up separately: lose
# it and the BVNs become unreadable, leak it and the ciphertext is worthless.
# Generate with: openssl rand -base64 32
PII_ENCRYPTION_KEY=""

# Service-role access to the Supabase Admin API. REQUIRED for account closure:
# without it the Auth user cannot be deleted, so the credentials would keep
# working after the user was told their account was closed. The endpoint now
# refuses rather than lying, so closure is unavailable until both are set.
SUPABASE_URL=""                                # https://<ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=""                   # Settings -> API -> service_role
